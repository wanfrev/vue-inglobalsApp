# Copia este archivo a ".env" y completa tu clave real. ".env" ya está en
# .gitignore, no se sube al repositorio.

# Cualquier proveedor con endpoint compatible con el SDK de OpenAI sirve acá
# (Gemini, DeepSeek, etc.) — solo cambia estas 3 variables, no hace falta
# tocar código.

# Ejemplo con Gemini (clave desde https://aistudio.google.com/apikey):
AI_API_KEY=tu_clave_secreta_aqui
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.6-flash

# Ejemplo con DeepSeek (comentado — descomenta y comenta el bloque de arriba si prefieres este):
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

AI_TEMPERATURE=0.1
# 4000, no 1000: con Gemini el razonamiento interno ("thinking") consume del
# mismo presupuesto que la respuesta visible — con 1000 la respuesta se corta
# a la mitad (JSON inválido). Verificado con pruebas reales.
AI_MAX_TOKENS=4000

# Precio por millón de tokens en USD, usado para estimar el costo mostrado
# junto a cada simulación (campo "usage" de la respuesta). Verifica el valor
# vigente antes de confiar en el estimado — cambia con el tiempo y según el
# proveedor/modelo. Valores actuales: Gemini 3.6 Flash $0.75/$3.75 (verificado
# 2026-09-12 en https://ai.google.dev/gemini-api/docs/pricing, sube a
# $1.50/$7.50 desde ene-2027); DeepSeek históricamente ~$0.27/$1.10.
AI_PRICE_INPUT_PER_1M=0.75
AI_PRICE_OUTPUT_PER_1M=3.75

# --- Variables para producción (Render u otro host) ---

# Dominio(s) del frontend permitidos para llamar a esta API. En local no hace
# falta tocarlo (por defecto "*"). En producción, pon el dominio real de
# Vercel — uno o varios separados por coma, sin espacios extra necesarios:
# CORS_ORIGINS=https://tu-app.vercel.app,https://tu-dominio-propio.com

# Carpeta donde vive la base de datos SQLite y el índice FAISS. En local no
# hace falta tocarlo (usa backend/data por defecto). En Render, debe apuntar
# a la ruta del disco persistente que configures (ver render.yaml):
# DATA_DIR=/var/data

