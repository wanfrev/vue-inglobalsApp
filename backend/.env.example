# Copia este archivo a ".env" y completa tu clave real. ".env" ya está en
# .gitignore, no se sube al repositorio.

DEEPSEEK_API_KEY=sk_tu_clave_secreta_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=1000

# Precio por millón de tokens en USD, usado para estimar el costo mostrado
# junto a cada simulación (campo "usage" de la respuesta). Verifica el valor
# vigente en https://api-docs.deepseek.com/quick_start/pricing antes de
# confiar en el estimado — cambia con el tiempo y según cache-hit/cache-miss.
DEEPSEEK_PRICE_INPUT_PER_1M=0.27
DEEPSEEK_PRICE_OUTPUT_PER_1M=1.10
