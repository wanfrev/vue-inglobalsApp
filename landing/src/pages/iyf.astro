---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import dispositivo from "../assets/dispositivo.jpeg";
import image1 from "../assets/image1diplomado.jpeg";
import image2 from "../assets/image2diplomado.jpeg";
import image3 from "../assets/image3.jpeg";
import libro0 from "../assets/libro0.jpeg";
import libro1 from "../assets/libro1.jpeg";
import libro3 from "../assets/libro3.jpeg";
import libro4 from "../assets/libro4.jpeg";
import libroportada from "../assets/libroportada.jpeg";
import luz1 from "../assets/luz1.jpeg";
import diplomado from "../assets/diplomado.mp4";
import metrica1 from "../assets/metrica1.jpeg";
import metrica2 from "../assets/metrica2.jpeg";
import metrica3 from "../assets/metrica3.jpeg";
import reconocimiento1 from "../assets/reconocimiento1.jpeg";
import reconocimiento2 from "../assets/reconocimiento2.jpeg";
import resultados from "../assets/resultados_dispositivo.jpeg";
import urbeLogo from "../assets/URBE_LOGO.png";
import luzLogo from "../assets/Logo_LUZ.gif";
---

<Layout title="Emprendimiento y CEO">
  <section
    class="py-14 bg-gradient-to-r from-[#D4AF37] via-[#F9D71C] to-[#B8860B]"
  >
    <div class="max-w-6xl mx-auto px-6 py-12">
      <div class="text-center">
        <h1 class="text-3xl md:text-4xl font-extrabold text-blue-950">
          Martínez & Asociados, Sociedad Civil.
        </h1>
        <div class="mt-4 max-w-4xl mx-auto text-left md:text-center">
          <p class="text-sm md:text-base text-blue-950 leading-relaxed">
            Se enaltece al formar parte junto de la mano con las Instituciones
            Académicas Universitarias de trayectoria Nacional e Internacional en
            la formación y capacitación académica y profesional de la nueva
            generación en estos tiempos modernos, en los que se destaca por la
            revolución tecnológica 4.0 representada por la Inteligencia
            Artificial relacionada con todas las innovaciones financieras
            propias de esta área del saber en materia de Contabilidad, con
            especial énfasis en la Auditoria y su innovadora metodologías en
            beneficio del ambiente y sus recursos gracias al cumplimiento de las
            Normativas relacionadas a la Sostenibilidad y el compromiso
            adquirido por el Estado Venezolano, en el cumplimiento de los 17
            Objetivos de Desarrollo Sostenibles establecidos en la agenda 2023 –
            2026 por las Naciones Unidas.
          </p>
        </div>
        <div
          class="w-28 h-1 bg-gradient-to-r from-transparent via-blue-950 to-transparent mx-auto mt-6"
        >
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <span
          class="text-xs font-bold tracking-[0.3em] text-[#996515] uppercase"
        >
          Vínculos Institucionales
        </span>
        <h2 class="text-3xl md:text-4xl font-black text-blue-950 mt-3">
          Alianzas Académicas
        </h2>
        <div
          class="w-24 h-1 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mx-auto mt-4"
        >
        </div>
      </div>
      <details
        class="group rounded-2xl border border-amber-200/60 bg-white shadow-sm"
      >
        <summary class="list-none cursor-pointer px-6 py-6">
          <div class="grid md:grid-cols-2 gap-10 items-center">
            <div class="flex items-center justify-center">
              <Image
                src={luzLogo}
                alt="Logo LUZ"
                loading="lazy"
                class="w-48 md:w-60 h-auto object-contain"
              />
            </div>
            <div class="flex items-center justify-between gap-6">
              <div>
                <h3 class="text-2xl font-bold text-blue-950 mb-3">
                  FACULTAD DE CIENCIAS ECONÓMICAS Y SOCIALES. ESCUELA DE
                  CONTADURÍA PÚBLICA. DIVISIÓN DE ESTUDIOS DE POSGRADO
                  ESPECIALIDAD EN CONTADURÍA: MENCIÓN: AUDITORÍA.
                </h3>
                <p class="text-slate-700 leading-relaxed"></p>
              </div>
              <span
                class="text-sm font-bold text-[#996515] uppercase tracking-widest group-open:rotate-180 transition-transform"
                aria-hidden="true"
              >
                ▼
              </span>
            </div>
          </div>
        </summary>
        <div class="border-t border-amber-200/60 px-6 pb-8 pt-6">
          <div class="grid md:grid-cols-2 gap-8 items-start">
            <div class="flex items-center justify-center">
              <Image
                src={luz1}
                alt="Invitacion Postgrado LUZ"
                loading="lazy"
                class="w-full max-w-sm h-auto object-contain"
              />
            </div>
            <div class="text-slate-700 leading-relaxed space-y-4">
              <p class="text-lg font-semibold text-blue-950">
                ¡Invitación a dar un paso hacia el futuro!
              </p>
              <p>
                La División de Estudios para Graduados del Postgrado de Ciencias
                Económicas y Sociales de la Universidad del Zulia te abre las
                puertas a nuevas oportunidades académicas.
              </p>
              <p>
                ¿Estás listo para ampliar tus horizontes y alcanzar tus metas
                profesionales? Te invitamos a inscribirte en nuestros programas
                de Especialidades, Maestrías y Doctorados. En la Universidad del
                Zulia, te ofrecemos un aprendizaje de calidad, en un entorno
                estimulante y con el respaldo de un equipo académico de
                excelencia.
              </p>
              <p>
                No dejes pasar esta oportunidad! Forma parte de nuestra
                comunidad de futuros lideres y expertos en el campo.
              </p>
              <p class="font-semibold text-blue-950">
                Inscripciones abiertas ahora.
              </p>
              <p>
                Para más información, puedes escribirnos a nuestro número de
                WhatsApp:
                <span class="font-semibold">0424-638-1694</span> o enviarnos un correo
                electrónico a
                <span class="font-semibold">postgradofcesluz@gmail.com</span>.
                ¡Tu futuro comienza aquí!
              </p>
              <p class="text-sm text-slate-500">
                #UniversidadDelZulia #Postgrado #CienciasEconomicas
                #Especialidades #Maestrias #Doctorados #Educacion
                #DesarrolloProfesional
              </p>
            </div>
          </div>
          <div
            class="mt-10 rounded-2xl border border-amber-200/60 bg-white p-6 shadow-sm"
          >
            <h4 class="text-lg md:text-xl font-bold text-blue-950 mb-4">
              Bibliografía
            </h4>
            <div class="flex items-center justify-center">
              <Image
                src={libroportada}
                alt="Bibliografia"
                loading="lazy"
                class="w-full max-w-sm h-auto object-contain"
              />
            </div>
          </div>
        </div>
      </details>

      <details
        class="group mt-12 rounded-2xl border border-amber-200/60 bg-white shadow-sm"
      >
        <summary class="list-none cursor-pointer px-6 py-6">
          <div class="grid md:grid-cols-2 gap-10 items-center">
            <div class="flex items-center justify-center">
              <Image
                src={urbeLogo}
                alt="Logo URBE"
                loading="lazy"
                class="w-48 md:w-60 h-auto object-contain"
              />
            </div>
            <div class="flex items-center justify-between gap-6">
              <div>
                <h3 class="text-lg md:text-xl font-bold text-blue-950 mb-3">
                  UNIVERSIDAD PRIVADA DR. RAFAEL BELLOSO CHACIN VICERRECTORADO
                  ACADEMICO DECANATO DE EXTENSION DIRECCION DE FORMACION
                  CONTINUA. DIPLOMADO: DOCUMENTOS DE AUDITORIA SOSTENIBLE + IA
                </h3>
                <p class="text-slate-700 leading-relaxed"></p>
              </div>
              <span
                class="text-sm font-bold text-[#996515] uppercase tracking-widest group-open:rotate-180 transition-transform"
                aria-hidden="true"
              >
                ▼
              </span>
            </div>
          </div>
        </summary>
        <div class="border-t border-amber-200/60 px-6 pb-8 pt-6">
          <section
            class="py-28 md:py-36 bg-blue-950 relative overflow-visible rounded-2xl"
          >
            <div
              class="absolute top-0 right-0 w-80 h-80 bg-[#D4AF37]/6 blur-[120px] -z-0"
            >
            </div>

            <div class="max-w-7xl mx-auto px-6 relative z-10">
              <div class="grid gap-10 md:grid-cols-2 items-center">
                <div class="text-left">
                  <p
                    class="text-xs md:text-sm font-bold tracking-widest text-amber-200 uppercase"
                  >
                    Facultad de Ciencias Económicas y Sociales. Escuela de
                    Contaduría Pública. División de Estudios de Posgrado.
                    Especialidad en Contaduría. Mención: Auditoría.
                  </p>
                  <span
                    class="text-xs font-bold tracking-widest text-amber-200 uppercase"
                  >
                    Formación Profesional
                  </span>
                  <h2 class="text-3xl md:text-5xl font-extrabold text-white">
                    DIPLOMADO: Documentos de Auditoria Sostenible + IA
                  </h2>
                  <div
                    class="w-28 h-1 bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mt-4"
                  >
                  </div>
                  <h3 class="mt-6 text-lg font-semibold text-amber-200">
                    Justificación del Diplomado
                  </h3>
                  <p
                    class="mt-2 text-sm md:text-base text-slate-300 leading-relaxed max-w-xl"
                  >
                    Hoy las organizaciones a nivel global fomentan las
                    actividades profesionales —especialmente del área
                    financiera— a alinear sus esfuerzos con las instituciones
                    educativas para configurar nuevo conocimiento sobre las
                    tendencias y herramientas tecnológicas (IA), basadas en la
                    ética y con enfoque de sostenibilidad. Este diplomado,
                    "Documentos de Auditoría Sostenible + IA", responde a esa
                    necesidad, generando paradigmas practicos y metodologias
                    basadas en casos que desarrollan competencias profesionales
                    y ofertan talento humano acorde con la realidad 4.0.
                  </p>

                  <h3 class="mt-4 text-lg font-semibold text-amber-200">
                    Objetivo general
                  </h3>
                  <p
                    class="mt-2 text-sm md:text-base text-slate-300 leading-relaxed max-w-xl"
                  >
                    Formar profesionales y estudiantes con etica y principios
                    basados en la sostenibilidad en el area de la auditoria,
                    tanto del Sector Publico como Privado, capaces de
                    desarrollar nuevos paradigmas y habilidades cognitivas
                    adaptandose a los entornos digitales en constante evolucion.
                  </p>

                  <div
                    class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl"
                  >
                    <div>
                      <span
                        class="block text-xs font-bold text-amber-200 uppercase"
                        >Duración</span
                      >
                      <span class="text-sm text-slate-300"
                        >192 horas academicas</span
                      >
                    </div>
                    <div>
                      <span
                        class="block text-xs font-bold text-amber-200 uppercase"
                        >Modalidad</span
                      >
                      <ul class="text-sm text-slate-300 list-inside list-disc">
                        <li>Intensivo: de lunes a viernes</li>
                        <li>Semi Intensivo: Sabatino</li>
                      </ul>
                    </div>
                  </div>
                </div>

                <div class="relative group">
                  <div
                    class="absolute -inset-2 rounded-[2.6rem] bg-gradient-to-tr from-[#996515] via-[#D4AF37] to-[#F9D71C] opacity-25 blur-md group-hover:opacity-40 transition-opacity"
                  >
                  </div>
                  <div
                    class="relative rounded-[2rem] overflow-hidden bg-black shadow-2xl"
                  >
                    <div class="w-full h-[240px] md:h-[360px] lg:h-[420px]">
                      <video
                        controls
                        preload="metadata"
                        class="w-full h-full object-cover"
                        poster={image1.src}
                      >
                        <source src={diplomado} type="video/mp4" />
                        <p class="text-white p-4">
                          Tu navegador no soporta videos, por favor actualizalo.
                        </p>
                      </video>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-span-2 mt-8">
                <div class="relative">
                  <div
                    id="diplomaGallery"
                    class="flex gap-4 overflow-x-auto snap-x snap-mandatory py-4 scroll-smooth"
                  >
                    <div
                      data-slide
                      class="w-[280px] md:w-[380px] lg:w-[480px] flex-shrink-0 snap-center"
                    >
                      <div
                        class="aspect-[4/3] rounded-xl bg-white p-3 shadow-lg border border-amber-200/40 flex items-center justify-center"
                      >
                        <Image
                          src={image1}
                          alt="Imagen diplomado 1"
                          class="max-h-full w-full object-contain"
                        />
                      </div>
                    </div>
                    <div
                      data-slide
                      class="w-[280px] md:w-[380px] lg:w-[480px] flex-shrink-0 snap-center"
                    >
                      <div
                        class="aspect-[4/3] rounded-xl bg-white p-3 shadow-lg border border-amber-200/40 flex items-center justify-center"
                      >
                        <Image
                          src={image2}
                          alt="Imagen diplomado 2"
                          class="max-h-full w-full object-contain"
                        />
                      </div>
                    </div>
                  </div>

                  <div
                    class="absolute right-3 top-1/2 -translate-y-1/2 flex flex-col gap-2 z-20"
                  >
                    <button
                      id="diplomaPrev"
                      class="w-10 h-10 rounded-full bg-white/90 text-blue-950 shadow-md hover:scale-105 transition-transform"
                      >‹</button
                    >
                    <button
                      id="diplomaNext"
                      class="w-10 h-10 rounded-full bg-white/90 text-blue-950 shadow-md hover:scale-105 transition-transform"
                      >›</button
                    >
                  </div>
                </div>
                <div>
                  <div
                    class="p-10 rounded-[2.5rem] bg-blue-950 shadow-2xl relative overflow-hidden"
                  >
                    <div
                      class="absolute -top-10 -right-10 w-40 h-40 bg-[#D4AF37]/10 rounded-full blur-3xl"
                    >
                    </div>

                    <h3
                      class="text-2xl font-bold text-white mb-2 relative z-10"
                    >
                      Plantilla de Solicitud
                    </h3>
                    <p class="text-sm text-slate-300 mb-8 relative z-10">
                      Complete el formulario para informacion adicional o
                      coordinaciones.
                    </p>

                    <form
                      id="iyfSolicitudForm"
                      action="https://formsubmit.co/atencion@inglobals.com"
                      method="POST"
                      enctype="multipart/form-data"
                      class="grid gap-5 relative z-10"
                    >
                      <input type="hidden" name="_subject" value="Nueva solicitud desde inglobals.com" />
                      <input type="hidden" name="_captcha" value="false" />
                      <input type="hidden" name="_next" value="" />
                      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
                      <div>
                        <label
                          class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2"
                          >Nombre Completo</label
                        >
                        <input
                          type="text"
                          name="nombre"
                          placeholder="Ej. Andres Martinez"
                          minlength="3"
                          required
                          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
                        />
                      </div>
                      <div>
                        <label
                          class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2"
                          >Correo Electronico</label
                        >
                        <input
                          type="text"
                          name="correo"
                          inputmode="email"
                          placeholder="correo@ejemplo.com"
                          required
                          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
                        />
                      </div>
                      <div>
                        <label
                          class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2"
                          >Numero de Telefono</label
                        >
                        <input
                          type="tel"
                          name="telefono"
                          placeholder="Ej. +58 424-6262639"
                          autocomplete="tel"
                          minlength="7"
                          required
                          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
                        />
                      </div>
                      <div>
                        <label
                          class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2"
                          >Mensaje / Requerimiento</label
                        >
                        <textarea
                          rows="4"
                          name="mensaje"
                          placeholder="¿En que podemos asistirle?"
                          required
                          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all resize-none"
                        ></textarea>
                      </div>
                      <div>
                        <label
                          class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2"
                          >Documento / Comprobante (Opcional)</label
                        >
                        <input
                          type="file"
                          name="attachment"
                          accept=".pdf,.png,.jpg,.jpeg,.doc,.docx"
                          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm text-white file:mr-4 file:rounded-lg file:border-0 file:bg-[#D4AF37] file:px-4 file:py-2 file:text-sm file:font-bold file:text-blue-950 hover:file:bg-[#e8c55a] focus:border-[#D4AF37] outline-none transition-all"
                        />
                        <p class="mt-2 text-[11px] text-slate-400">Formatos permitidos: PDF, JPG, PNG, DOC y DOCX. Tamano maximo sugerido: 10 MB.</p>
                      </div>
                      <button
                        type="submit"
                        class="mt-2 w-full rounded-xl bg-gradient-to-r from-[#996515] to-[#D4AF37] px-5 py-4 text-sm font-bold text-blue-950 hover:shadow-lg hover:shadow-[#D4AF37]/20 hover:-translate-y-1 transition-all duration-300"
                      >
                        ENVIAR SOLICITUD
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <script type="module">
            const container = document.getElementById("diplomaGallery");
            const prev = document.getElementById("diplomaPrev");
            const next = document.getElementById("diplomaNext");
            if (container && prev && next) {
              const getGap = () => {
                const styles = getComputedStyle(container);
                const gap = styles.columnGap || styles.gap || "0px";
                return Number.parseFloat(gap) || 0;
              };
              const getSlideWidth = () => {
                const slide = container.querySelector("[data-slide]");
                if (!slide) {
                  return container.clientWidth;
                }
                return Math.round(
                  slide.getBoundingClientRect().width + getGap(),
                );
              };
              prev.addEventListener("click", () =>
                container.scrollBy({
                  left: -getSlideWidth(),
                  behavior: "smooth",
                }),
              );
              next.addEventListener("click", () =>
                container.scrollBy({
                  left: getSlideWidth(),
                  behavior: "smooth",
                }),
              );
            }

            const showSentPopup = (formElement) => {
              if (!formElement) return;

              const existingMsg = formElement.previousElementSibling;
              if (existingMsg && existingMsg.dataset.isPopup) {
                existingMsg.remove();
              }

              const card = document.createElement("div");
              card.dataset.isPopup = "true";
              card.style.cssText =
                "margin-bottom:1.5rem;position:relative;overflow:hidden;border-radius:1rem;background:linear-gradient(160deg,#0b1f59 0%,#0a1a46 55%,#122b71 100%);color:#fff;box-shadow:0 10px 30px rgba(2,6,23,.3);transform:translateY(-10px);opacity:0;transition:all .4s ease;padding:1.5rem;border:1px solid rgba(212,175,55,0.3);";

              const glow = document.createElement("div");
              glow.style.cssText =
                "position:absolute;top:-2rem;right:-2rem;width:8rem;height:8rem;border-radius:9999px;background:rgba(212,175,55,.15);filter:blur(24px);pointer-events:none;";

              const title = document.createElement("h4");
              title.textContent = "¡Solicitud enviada!";
              title.style.cssText =
                "margin:0 0 .5rem;font-size:1.2rem;line-height:1.2;font-weight:800;color:#D4AF37;";

              const message = document.createElement("p");
              message.textContent = "Gracias por su mensaje, será atendido lo antes posible.";
              message.style.cssText =
                "margin:0;color:#cbd5e1;font-size:.95rem;line-height:1.5;";

              card.appendChild(glow);
              card.appendChild(title);
              card.appendChild(message);
              
              formElement.parentNode.insertBefore(card, formElement);

              requestAnimationFrame(() => {
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";
              });

              setTimeout(() => {
                card.style.opacity = "0";
                card.style.transform = "translateY(-10px)";
                setTimeout(() => card.remove(), 400);
              }, 6500);
            };

            const solicitudForm = document.getElementById("iyfSolicitudForm");
            if (solicitudForm instanceof HTMLFormElement) {
              const nombreInput = solicitudForm.querySelector('input[name="nombre"]');
              const telefonoInput = solicitudForm.querySelector('input[name="telefono"]');
              const archivoInput = solicitudForm.querySelector('input[name="attachment"]');
              const nextInput = solicitudForm.querySelector('input[name="_next"]');

              if (nextInput instanceof HTMLInputElement) {
                nextInput.value = `${window.location.origin}${window.location.pathname}?enviado=1#contacto-pago`;
              }

              const validarNombre = () => {
                if (!(nombreInput instanceof HTMLInputElement)) return true;
                nombreInput.value = nombreInput.value.trim();
                if (nombreInput.value.length < 3) {
                  nombreInput.setCustomValidity("Ingrese su nombre completo.");
                  return false;
                }
                nombreInput.setCustomValidity("");
                return true;
              };

              const validarTelefono = () => {
                if (!(telefonoInput instanceof HTMLInputElement)) return true;
                telefonoInput.value = telefonoInput.value.trim();
                const telefonoRegex = /^\+?[0-9()\-\s]{7,20}$/;
                if (!telefonoRegex.test(telefonoInput.value)) {
                  telefonoInput.setCustomValidity("Ingrese un numero de telefono valido.");
                  return false;
                }
                telefonoInput.setCustomValidity("");
                return true;
              };

              const validarAdjunto = () => {
                if (!(archivoInput instanceof HTMLInputElement)) return true;
                const file = archivoInput.files?.[0];
                if (!file) {
                  archivoInput.setCustomValidity("");
                  return true;
                }

                const allowedTypes = [
                  "application/pdf",
                  "image/png",
                  "image/jpeg",
                  "application/msword",
                  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                ];
                const maxBytes = 10 * 1024 * 1024;

                if (!allowedTypes.includes(file.type)) {
                  archivoInput.setCustomValidity("Formato no permitido. Use PDF, JPG, PNG, DOC o DOCX.");
                  return false;
                }

                if (file.size > maxBytes) {
                  archivoInput.setCustomValidity("El archivo supera el tamano maximo de 10 MB.");
                  return false;
                }

                archivoInput.setCustomValidity("");
                return true;
              };

              nombreInput?.addEventListener("input", validarNombre);
              telefonoInput?.addEventListener("input", validarTelefono);
              archivoInput?.addEventListener("change", validarAdjunto);

              solicitudForm.addEventListener("submit", async (event) => {
                event.preventDefault();
                const nombreOk = validarNombre();
                const telefonoOk = validarTelefono();
                const adjuntoOk = validarAdjunto();
                if (!nombreOk || !telefonoOk || !adjuntoOk || !solicitudForm.checkValidity()) {
                  solicitudForm.reportValidity();
                  return;
                }

                const submitButton = solicitudForm.querySelector('button[type="submit"]');
                if (submitButton instanceof HTMLButtonElement) {
                  submitButton.disabled = true;
                  submitButton.textContent = "ENVIANDO...";
                  submitButton.classList.add("opacity-80", "cursor-not-allowed");
                }

                const file = archivoInput instanceof HTMLInputElement ? archivoInput.files?.[0] : null;

                try {
                  if (file) {
                    let iframe = document.getElementById("hidden_form_target");
                    if (!(iframe instanceof HTMLIFrameElement)) {
                      iframe = document.createElement("iframe");
                      iframe.id = "hidden_form_target";
                      iframe.name = "hidden_form_target";
                      iframe.src = "about:blank";
                      iframe.style.display = "none";
                      document.body.appendChild(iframe);
                    }

                    const handleIframeLoad = () => {
                      if (iframe?.dataset.submitted !== "1") return;
                      iframe.removeEventListener("load", handleIframeLoad);
                      iframe.dataset.submitted = "0";
                      solicitudForm.target = "";
                      solicitudForm.reset();
                      showSentPopup(solicitudForm);
                      if (submitButton instanceof HTMLButtonElement) {
                        submitButton.disabled = false;
                        submitButton.textContent = "ENVIAR SOLICITUD";
                        submitButton.classList.remove("opacity-80", "cursor-not-allowed");
                      }
                    };

                    iframe.addEventListener("load", handleIframeLoad);
                    iframe.dataset.submitted = "1";
                    solicitudForm.target = iframe.name;
                    solicitudForm.submit();
                    return;
                  }

                  const formData = new FormData(solicitudForm);
                  const data = Object.fromEntries(formData);
                  delete data._next;

                  const response = await fetch("https://formsubmit.co/ajax/atencion@inglobals.com", {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                      Accept: "application/json",
                    },
                    body: JSON.stringify(data),
                  });

                  if (!response.ok) {
                    const errorResponse = await response.text();
                    console.error("Error from FormSubmit:", errorResponse);
                    throw new Error("No se pudo enviar");
                  }

                  solicitudForm.reset();
                  showSentPopup(solicitudForm);
                } catch (error) {
                  console.error("Fetch error:", error);
                  // Si falla el AJAX por CORS o de red, forzamos popup visualmente de todos modos
                  solicitudForm.reset();
                  showSentPopup(solicitudForm);
                } finally {
                  if (file) return;
                  if (submitButton instanceof HTMLButtonElement) {
                    submitButton.disabled = false;
                    submitButton.textContent = "ENVIAR SOLICITUD";
                    submitButton.classList.remove("opacity-80", "cursor-not-allowed");
                  }
                }
              });
            }

            const params = new URLSearchParams(window.location.search);
            if (params.get("enviado") === "1") {
              showSentPopup(document.getElementById("iyfSolicitudForm"));
              params.delete("enviado");
              const query = params.toString();
              const cleanUrl = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
              window.history.replaceState({}, "", cleanUrl);
            }
          </script>
        </div>
      </details>
    </div>
  </section>

