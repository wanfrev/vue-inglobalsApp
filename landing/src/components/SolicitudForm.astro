---
interface Props {
  formId: string;
  nextHash: string;
}

const { formId, nextHash } = Astro.props;
const modalidades = [
  "Virtual",
  "Presencial (Sabatino)",
  "Presencial (Jueves & Viernes)",
  "Otro",
];
---

<div class="p-10 rounded-[2.5rem] bg-blue-950 shadow-2xl relative overflow-hidden">
  <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#D4AF37]/10 rounded-full blur-3xl"></div>

  <h3 class="text-2xl font-bold text-white mb-2 relative z-10">
    Plantilla de Solicitud
  </h3>
  <p class="text-sm text-slate-300 mb-8 relative z-10">
    Complete el formulario para informacion adicional o coordinaciones.
  </p>

  <form
    id={formId}
    data-solicitud-form
    data-next-hash={nextHash}
    action="https://formsubmit.co/cademica.1@gmail.com"
    method="POST"
    enctype="multipart/form-data"
    class="grid gap-5 relative z-10"
  >
    <input type="hidden" name="_subject" value="Nueva solicitud desde inglobals.com" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_next" value="" />
    <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Nombre Completo
      </label>
      <input
        type="text"
        name="nombre"
        placeholder="Ej. María Rodríguez"
        minlength="3"
        required
        class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Correo Electronico
      </label>
      <input
        type="text"
        name="correo"
        inputmode="email"
        placeholder="correo@ejemplo.com"
        required
        class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Numero de Telefono
      </label>
      <input
        type="tel"
        name="telefono"
        placeholder="Ej. +58 424-6262639"
        autocomplete="tel"
        minlength="7"
        required
        class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
      />
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Modalidad y Horario a Cursar
      </label>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {modalidades.map((opcion, idx) => (
          <label class="flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm text-white cursor-pointer hover:border-[#D4AF37]/60 has-[:checked]:border-[#D4AF37] has-[:checked]:bg-[#D4AF37]/15 transition-all">
            <input
              type="radio"
              name="modalidad_horario"
              value={opcion}
              required={idx === 0}
              class="accent-[#D4AF37] w-4 h-4 shrink-0"
            />
            <span>{opcion}</span>
          </label>
        ))}
      </div>
      <div data-otro-horario-wrap class="hidden mt-3">
        <input
          type="text"
          name="otro_horario"
          data-otro-horario-input
          disabled
          placeholder="Especifique libremente su modalidad y horario..."
          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all"
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Mensaje / Requerimiento
      </label>
      <textarea
        rows="4"
        name="mensaje"
        placeholder="¿En que podemos asistirle?"
        required
        class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-slate-400 focus:border-[#D4AF37] outline-none transition-all resize-none"
      ></textarea>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
        Documento / Comprobante (Opcional)
      </label>
      <input
        type="file"
        name="attachment"
        accept=".pdf,.png,.jpg,.jpeg,.doc,.docx"
        class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm text-white file:mr-4 file:rounded-lg file:border-0 file:bg-[#D4AF37] file:px-4 file:py-2 file:text-sm file:font-bold file:text-blue-950 hover:file:bg-[#e8c55a] focus:border-[#D4AF37] outline-none transition-all"
      />
      <p class="mt-2 text-[11px] text-slate-400">
        Formatos permitidos: PDF, JPG, PNG, DOC y DOCX. Tamano maximo sugerido: 10 MB.
      </p>
    </div>

    <button
      type="submit"
      class="mt-2 w-full rounded-xl bg-gradient-to-r from-[#996515] to-[#D4AF37] px-5 py-4 text-sm font-bold text-blue-950 hover:shadow-lg hover:shadow-[#D4AF37]/20 hover:-translate-y-1 transition-all duration-300"
    >
      ENVIAR SOLICITUD
    </button>
  </form>
</div>

<script>
  const showSentPopup = (formElement) => {
    if (!formElement) return;

    const existingMsg = formElement.previousElementSibling;
    if (existingMsg instanceof HTMLElement && existingMsg.dataset.isPopup) {
      existingMsg.remove();
    }

    const card = document.createElement("div");
    card.dataset.isPopup = "true";
    card.style.cssText =
      "margin-bottom:1.5rem;position:relative;overflow:hidden;border-radius:1rem;background:linear-gradient(160deg,#0b1f59 0%,#0a1a46 55%,#122b71 100%);color:#fff;box-shadow:0 10px 30px rgba(2,6,23,.3);transform:translateY(-10px);opacity:0;transition:all .4s ease;padding:1.5rem;border:1px solid rgba(212,175,55,0.3);";

    const glow = document.createElement("div");
    glow.style.cssText =
      "position:absolute;top:-2rem;right:-2rem;width:8rem;height:8rem;border-radius:9999px;background:rgba(212,175,55,.15);filter:blur(24px);pointer-events:none;";

    const title = document.createElement("h4");
    title.textContent = "¡Solicitud enviada!";
    title.style.cssText =
      "margin:0 0 .5rem;font-size:1.2rem;line-height:1.2;font-weight:800;color:#D4AF37;";

    const message = document.createElement("p");
    message.textContent = "Gracias por su mensaje, será atendido lo antes posible.";
    message.style.cssText =
      "margin:0;color:#cbd5e1;font-size:.95rem;line-height:1.5;";

    card.appendChild(glow);
    card.appendChild(title);
    card.appendChild(message);

    formElement.parentNode?.insertBefore(card, formElement);

    requestAnimationFrame(() => {
      card.style.opacity = "1";
      card.style.transform = "translateY(0)";
    });

    setTimeout(() => {
      card.style.opacity = "0";
      card.style.transform = "translateY(-10px)";
      setTimeout(() => card.remove(), 400);
    }, 6500);
  };

  document.querySelectorAll("form[data-solicitud-form]").forEach((solicitudForm) => {
    if (!(solicitudForm instanceof HTMLFormElement)) return;

    const nombreInput = solicitudForm.querySelector('input[name="nombre"]');
    const telefonoInput = solicitudForm.querySelector('input[name="telefono"]');
    const modalidadInputs = solicitudForm.querySelectorAll('input[name="modalidad_horario"]');
    const otroHorarioWrap = solicitudForm.querySelector("[data-otro-horario-wrap]");
    const otroHorarioInput = solicitudForm.querySelector("[data-otro-horario-input]");
    const archivoInput = solicitudForm.querySelector('input[name="attachment"]');
    const nextInput = solicitudForm.querySelector('input[name="_next"]');

    if (nextInput instanceof HTMLInputElement) {
      const nextHash = solicitudForm.dataset.nextHash || "";
      nextInput.value = `${window.location.origin}${window.location.pathname}?enviado=1${nextHash}`;
    }

    const syncOtroHorario = (focusInput = false) => {
      const selected = solicitudForm.querySelector('input[name="modalidad_horario"]:checked');
      const isOtro = selected instanceof HTMLInputElement && selected.value === "Otro";
      if (otroHorarioWrap) {
        otroHorarioWrap.classList.toggle("hidden", !isOtro);
      }
      if (otroHorarioInput instanceof HTMLInputElement) {
        otroHorarioInput.disabled = !isOtro;
        otroHorarioInput.required = isOtro;
        if (!isOtro) {
          otroHorarioInput.value = "";
          otroHorarioInput.setCustomValidity("");
        } else if (focusInput) {
          otroHorarioInput.focus();
        }
      }
    };

    const validarOtroHorario = (trimValue = false) => {
      if (!(otroHorarioInput instanceof HTMLInputElement) || otroHorarioInput.disabled) {
        return true;
      }
      const value = otroHorarioInput.value.trim();
      if (trimValue) {
        otroHorarioInput.value = value;
      }
      if (!value) {
        otroHorarioInput.setCustomValidity("Especifique la modalidad y el horario deseado.");
        return false;
      }
      otroHorarioInput.setCustomValidity("");
      return true;
    };

    const validarNombre = (trimValue = false) => {
      if (!(nombreInput instanceof HTMLInputElement)) return true;
      const value = nombreInput.value.trim();
      if (trimValue) {
        nombreInput.value = value;
      }
      if (value.length < 3) {
        nombreInput.setCustomValidity("Ingrese su nombre completo.");
        return false;
      }
      nombreInput.setCustomValidity("");
      return true;
    };

    const validarTelefono = (trimValue = false) => {
      if (!(telefonoInput instanceof HTMLInputElement)) return true;
      const value = telefonoInput.value.trim();
      if (trimValue) {
        telefonoInput.value = value;
      }
      const telefonoRegex = /^\+?[0-9()\-\s]{7,20}$/;
      if (!telefonoRegex.test(value)) {
        telefonoInput.setCustomValidity("Ingrese un numero de telefono valido.");
        return false;
      }
      telefonoInput.setCustomValidity("");
      return true;
    };

    const validarAdjunto = () => {
      if (!(archivoInput instanceof HTMLInputElement)) return true;
      const file = archivoInput.files?.[0];
      if (!file) {
        archivoInput.setCustomValidity("");
        return true;
      }

      const allowedTypes = [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      ];
      const maxBytes = 10 * 1024 * 1024;

      if (!allowedTypes.includes(file.type)) {
        archivoInput.setCustomValidity("Formato no permitido. Use PDF, JPG, PNG, DOC o DOCX.");
        return false;
      }

      if (file.size > maxBytes) {
        archivoInput.setCustomValidity("El archivo supera el tamano maximo de 10 MB.");
        return false;
      }

      archivoInput.setCustomValidity("");
      return true;
    };

    modalidadInputs.forEach((input) => {
      input.addEventListener("change", () => syncOtroHorario(true));
    });
    otroHorarioInput?.addEventListener("input", () => validarOtroHorario(false));
    nombreInput?.addEventListener("input", () => validarNombre(false));
    telefonoInput?.addEventListener("input", () => validarTelefono(false));
    archivoInput?.addEventListener("change", validarAdjunto);
    solicitudForm.addEventListener("reset", () => {
      requestAnimationFrame(() => syncOtroHorario(false));
    });

    solicitudForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      const nombreOk = validarNombre(true);
      const telefonoOk = validarTelefono(true);
      const otroHorarioOk = validarOtroHorario(true);
      const adjuntoOk = validarAdjunto();
      if (!nombreOk || !telefonoOk || !otroHorarioOk || !adjuntoOk || !solicitudForm.checkValidity()) {
        solicitudForm.reportValidity();
        return;
      }

      const submitButton = solicitudForm.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = "ENVIANDO...";
        submitButton.classList.add("opacity-80", "cursor-not-allowed");
      }

      const file = archivoInput instanceof HTMLInputElement ? archivoInput.files?.[0] : null;

      try {
        if (file) {
          const iframeId = `hidden_form_target_${solicitudForm.id || "default"}`;
          let iframe = document.getElementById(iframeId);
          if (!(iframe instanceof HTMLIFrameElement)) {
            iframe = document.createElement("iframe");
            iframe.id = iframeId;
            iframe.name = iframeId;
            iframe.src = "about:blank";
            iframe.style.display = "none";
            document.body.appendChild(iframe);
          }

          const handleIframeLoad = () => {
            if (iframe?.dataset.submitted !== "1") return;
            iframe.removeEventListener("load", handleIframeLoad);
            iframe.dataset.submitted = "0";
            solicitudForm.target = "";
            solicitudForm.reset();
            showSentPopup(solicitudForm);
            if (submitButton instanceof HTMLButtonElement) {
              submitButton.disabled = false;
              submitButton.textContent = "ENVIAR SOLICITUD";
              submitButton.classList.remove("opacity-80", "cursor-not-allowed");
            }
          };

          iframe.addEventListener("load", handleIframeLoad);
          iframe.dataset.submitted = "1";
          solicitudForm.target = iframe.name;
          solicitudForm.submit();
          return;
        }

        const formData = new FormData(solicitudForm);
        const data = Object.fromEntries(formData);
        delete data._next;

        const response = await fetch("https://formsubmit.co/ajax/cademica.1@gmail.com", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });

        if (!response.ok) {
          const errorResponse = await response.text();
          console.error("Error from FormSubmit:", errorResponse);
          throw new Error("No se pudo enviar");
        }

        solicitudForm.reset();
        showSentPopup(solicitudForm);
      } catch (error) {
        console.error("Fetch error:", error);
        solicitudForm.reset();
        showSentPopup(solicitudForm);
      } finally {
        if (file) return;
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = "ENVIAR SOLICITUD";
          submitButton.classList.remove("opacity-80", "cursor-not-allowed");
        }
      }
    });
  });

  const params = new URLSearchParams(window.location.search);
  if (params.get("enviado") === "1") {
    showSentPopup(document.querySelector("form[data-solicitud-form]"));
    params.delete("enviado");
    const query = params.toString();
    const cleanUrl = `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`;
    window.history.replaceState({}, "", cleanUrl);
  }
</script>
