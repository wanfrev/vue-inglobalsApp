---
import { Image } from "astro:assets";
import iaasLogo from "../assets/iaas-logo.png";

// En producción, PUBLIC_SIMULATOR_URL apunta a https://inglobals.com/simulador
// (ver DEPLOY_VPS.md); sin esa variable cae al simulador del mismo dominio.
const simuladorUrl = import.meta.env.PUBLIC_SIMULATOR_URL || "/simulador/";
---

<nav class="fixed inset-x-0 top-4 z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div
      class="flex items-center justify-between rounded-full border border-amber-200/40 bg-white/90 backdrop-blur-md px-6 py-3 shadow-lg shadow-blue-900/5"
    >
      <a href="/" class="flex items-center space-x-3 group">
        <img
          src="/logo.png"
          alt="Inglobals logo"
          class="h-8 md:h-10 group-hover:scale-105 transition-transform"
        />
        <span class="text-2xl font-bold text-blue-950 tracking-tight">
          Inglobal<span
            class="text-transparent bg-clip-text bg-gradient-to-tr from-[#996515] via-[#D4AF37] to-[#F9D71C]"
            >S</span
          >
        </span>
      </a>

      <div class="flex items-center gap-4">
        <div
          class="hidden md:flex items-center gap-6 text-sm font-semibold text-blue-950"
        >
          <a href="/" class="text-blue-950 hover:text-[#D4AF37] transition-colors">M&A Consultorias</a>
          <a href="/iyf" class="relative group overflow-hidden">
            <span class="text-blue-950 hover:text-[#D4AF37] transition-colors"
              >Investigacion & Formacion Profesional</span
            >
            <span
              class="absolute bottom-0 left-0 w-full h-0.5 bg-[#D4AF37] -translate-x-full group-hover:translate-x-0 transition-transform"
            ></span>
          </a>
        </div>

        <!-- Acceso directo al simulador: escudo + nombre (solo el escudo en
        pantallas muy angostas, para que quepa junto al menú). -->
        <a
          href={simuladorUrl}
          aria-label="Simulador Sostenible (IA)"
          class="group/sim inline-flex rounded-full bg-gradient-to-tr from-[#996515] via-[#D4AF37] to-[#F9D71C] p-[2px] shadow-[0_0_18px_rgba(212,175,55,0.45)] transition-transform duration-300 hover:scale-105 hover:shadow-[0_0_26px_rgba(212,175,55,0.65)]"
        >
          <span class="inline-flex items-center gap-2 rounded-full bg-white px-2 py-1 sm:pl-2.5 sm:pr-4">
            <Image src={iaasLogo} alt="" class="h-7 w-auto object-contain sm:h-8" />
            <span class="hidden whitespace-nowrap text-sm font-extrabold tracking-tight text-blue-950 sm:inline">Simulador Sostenible (IA)</span>
          </span>
        </a>

        <details class="relative md:hidden group">
          <summary
            class="list-none cursor-pointer rounded-full border border-amber-200 bg-white p-2 shadow-sm hover:bg-amber-50 transition-colors"
          >
            <span class="sr-only">Abrir menu</span>
            <svg
              class="h-5 w-5 text-blue-950"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </summary>
          <div
            class="absolute right-0 mt-3 w-64 rounded-2xl border border-amber-100 bg-white p-4 shadow-xl"
          >
            <a
              href="/"
              class="block rounded-lg px-3 py-2 text-sm font-semibold text-blue-950 hover:bg-amber-50 hover:text-[#996515]"
              >Inicio</a
            >
            <a
              href="/iyf"
              class="mt-1 block rounded-lg px-3 py-2 text-sm font-semibold text-blue-950 hover:bg-amber-50 hover:text-[#996515]"
              >Investigacion & Formacion Profesional</a
            >
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>
