# URL pública del simulador (Vue) al que apunta el botón "SIMULADOR" de esta
# página. Astro incrusta esto en el build (como Vite con VITE_*), así que hay
# que recompilar (`npm run build`) si cambia. Sin este archivo, usa el
# default hardcodeado en el código (https://app.inglobals.com).

PUBLIC_SIMULATOR_URL=https://app.inglobals.com
