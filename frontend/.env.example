# Copia a ".env" para desarrollo local si tu backend no corre en el puerto
# 8000 por defecto. En Vercel, esta variable se configura en el dashboard del
# proyecto (Settings → Environment Variables) con la URL pública real del
# backend (ej. https://inglobals-backend.onrender.com) — Vite la incrusta en
# el build, así que hay que volver a desplegar si cambia.

VITE_API_BASE_URL=http://localhost:8000
