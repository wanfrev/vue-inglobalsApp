[Unit]
Description=InglobalsApp DAD backend (FastAPI + Gunicorn)
After=network.target

[Service]
Type=simple
User=inglobals
Group=inglobals
WorkingDirectory=/home/inglobals/vue-inglobalsApp/backend
EnvironmentFile=/home/inglobals/vue-inglobalsApp/backend/.env

# --workers 2, no más: el modelo de embeddings (sentence-transformers) y el
# índice FAISS se cargan en memoria POR WORKER (son procesos separados, no
# comparten RAM). Con 4 o más workers en un Quasar (6GB) te quedas sin
# margen. 2 workers ya permite atender 2 consultas reales en paralelo sin
# que se bloqueen entre sí (ver nota en app/api/simulate.py).
# --timeout 500: cada llamada a la IA (Prompt 1 y Prompt 2) ahora prueba
# hasta 2 proveedores (principal + respaldo opcional AI_FALLBACK_*), 2
# intentos cada uno, 60s de timeout por intento — ver app/core/engine.py.
# Peor caso teórico por llamada: 2 proveedores x 2 intentos x 60s = 240s: dos
# llamadas por consulta ≈ 480s. Es un techo para el caso raro (todo falla
# dos veces en ambos proveedores), no lo esperable — pero si Gunicorn mata
# el worker antes de eso, el usuario ve un 502/timeout crudo en vez de que
# el respaldo alcance a responder.
ExecStart=/home/inglobals/vue-inglobalsApp/backend/venv/bin/gunicorn app.main:app \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 500 \
    --access-logfile - \
    --error-logfile -

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
