[Unit]
Description=InglobalsApp DAD backend (FastAPI + Gunicorn)
After=network.target
# Si el servicio se cae en bucle, que systemd deje de reintentar tras 5 fallos
# en 10 minutos en vez de martillar el servidor (revisar con journalctl).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=inglobals
Group=inglobals
WorkingDirectory=/home/inglobals/vue-inglobalsApp/backend
EnvironmentFile=/home/inglobals/vue-inglobalsApp/backend/.env
# Limita los hilos de PyTorch/NumPy/FAISS por worker: sin esto cada worker abre
# un hilo por CPU y varios buffers por hilo al cargar el modelo o buscar, lo
# que dispara el uso de memoria y de CPU sin hacer las consultas más rápidas.
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false

# --workers 2, no más: el modelo de embeddings (sentence-transformers) y el
# índice FAISS se cargan en memoria POR WORKER (son procesos separados, no
# comparten RAM). Con 4 o más workers en un Quasar (6GB) te quedas sin
# margen. 2 workers ya permite atender 2 consultas reales en paralelo sin
# que se bloqueen entre sí (ver nota en app/api/simulate.py).
# --timeout 500: cada llamada a la IA (Prompt 1 y Prompt 2) ahora prueba
# hasta 2 proveedores (principal + respaldo opcional AI_FALLBACK_*), 2
# intentos cada uno, 60s de timeout por intento — ver app/core/engine.py.
# Peor caso teórico por llamada: 2 proveedores x 2 intentos x 60s = 240s: dos
# llamadas por consulta ≈ 480s. Es un techo para el caso raro (todo falla
# dos veces en ambos proveedores), no lo esperable — pero si Gunicorn mata
# el worker antes de eso, el usuario ve un 502/timeout crudo en vez de que
# el respaldo alcance a responder.
ExecStart=/home/inglobals/vue-inglobalsApp/backend/venv/bin/gunicorn app.main:app \
    --workers 2 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 500 \
    --max-requests 800 \
    --max-requests-jitter 80 \
    --access-logfile - \
    --error-logfile -

# --max-requests: cada worker se recicla tras ~800 consultas, así cualquier
# fuga lenta de memoria (modelos, índice, PDFs) no se acumula durante semanas.
# El jitter evita que los 2 workers se reinicien a la vez.

# Tope de memoria PROPIO del servicio (cgroup): si el backend se descontrola,
# systemd lo frena/reinicia a él solo, en vez de dejar sin RAM a todo el
# servidor (SSH, Nginx, systemd). Dejan ~1 GB libre para el sistema en un
# Quasar de 6 GB. MemoryHigh frena (reclama memoria); MemoryMax es el techo
# duro. Ajusta con el valor real: `systemctl status inglobals-backend` muestra
# "Memory:" con el pico actual.
MemoryHigh=4200M
MemoryMax=5000M
# Si el kernel necesita matar algo por falta de memoria, que sea el backend
# antes que sshd, nginx o systemd.
OOMScoreAdjust=500

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
